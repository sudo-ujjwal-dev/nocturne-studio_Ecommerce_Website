# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string 
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nocturne_studio"

# Server
PORT=4000
NODE_ENV=development

# Optional: comma-separated list of extra origins allowed to call the API
# directly (e.g. a separately-hosted frontend, or Postman/Insomnia during
# development). Not needed for normal use — the server serves the frontend
# itself, so same-origin requests are always allowed.
CLIENT_ORIGIN=""

# JWT
JWT_SECRET="replace-with-a-long-random-string-used"  //to transmit information between a client and a server as a verified JSON object
JWT_EXPIRES_IN="7d"

# Cart/checkout
FLAT_SHIPPING_RATE=12.00
FREE_SHIPPING_THRESHOLD=150.00
